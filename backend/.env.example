# SimplyStore Backend - Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string (required)
# Get it from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/simplystore?retryWrites=true&w=majority

# JWT Secret — change this to a long random string in production
JWT_SECRET=simplystore_jwt_secret_key_123

# Port (optional, defaults to 8000)
PORT=8000
